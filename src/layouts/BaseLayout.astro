---
import "../styles/global.css";
import "../styles/header.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Tiago VibesOn",
    description = "HandsOn, helping the Hero Association."
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f7f7f2" />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <div class="site-identity">
                <a class="brand" href="/">Tiago VibesOn</a>
                <span class="tagline">HandsOn, helping the Hero Association.</span>
            </div>
            <nav aria-label="Primary navigation">
                <a href="https://github.com/tiago-vibes-on/hands-on" rel="noreferrer">GitHub</a>
                <span aria-hidden="true">|</span>
                <a href="https://www.linkedin.com/in/tiago-pereira-qwe" rel="noreferrer">LinkedIn</a>
                <span aria-hidden="true">|</span>
                <a href="https://www.youtube.com/@TiagoVibesOn" rel="noreferrer">YouTube</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <a href="https://github.com/tiago-vibes-on/hands-on" rel="noreferrer">Source code</a>
        </footer>
    </body>
</html>
