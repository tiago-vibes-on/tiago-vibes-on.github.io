---
import "../styles/global.css";
import "../styles/header.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Tiago VibesOn",
    description = "HandsOn, helping the Hero Association."
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f7f7f2" />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <div class="site-identity">
                <a class="brand" href="/">Tiago VibesOn</a>
                <span class="tagline">HandsOn, helping the Hero Association.</span>
            </div>
            <nav aria-label="Primary navigation">
                <a class="social-link" href="https://github.com/tiago-vibes-on/hands-on" rel="noreferrer" aria-label="GitHub" title="GitHub">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.49.5.092.683-.217.683-.483 0-.237-.009-1.025-.013-1.86-2.782.604-3.369-1.18-3.369-1.18-.455-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.004.071 1.532 1.031 1.532 1.031.892 1.529 2.341 1.087 2.91.831.091-.646.349-1.087.635-1.337-2.221-.253-4.555-1.111-4.555-4.944 0-1.092.391-1.985 1.03-2.685-.104-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.026A9.564 9.564 0 0 1 12 6.487c.85.004 1.706.115 2.504.337 1.909-1.295 2.748-1.026 2.748-1.026.546 1.377.203 2.394.1 2.647.64.7 1.028 1.593 1.028 2.685 0 3.842-2.338 4.688-4.566 4.936.359.31.679.92.679 1.855 0 1.339-.012 2.418-.012 2.747 0 .268.18.579.688.481A10.002 10.002 0 0 0 22 12c0-5.523-4.477-10-10-10Z" /></svg>
                </a>
                <span aria-hidden="true">|</span>
                <a class="social-link" href="https://www.linkedin.com/in/tiago-pereira-qwe" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.85-3.037-1.853 0-2.136 1.445-2.136 2.94v5.666H9.354V9h3.413v1.561h.049c.475-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433A2.062 2.062 0 1 1 5.337 3.31a2.062 2.062 0 0 1 0 4.123ZM7.119 20.452H3.555V9h3.564v11.452Z" /></svg>
                </a>
                <span aria-hidden="true">|</span>
                <a class="social-link" href="https://www.youtube.com/@TiagoVibesOn" rel="noreferrer" aria-label="YouTube" title="YouTube">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M23.498 6.186a2.997 2.997 0 0 0-2.11-2.12C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.389.566a2.997 2.997 0 0 0-2.11 2.12C0 8.079 0 12 0 12s0 3.921.501 5.814a2.997 2.997 0 0 0 2.11 2.12C4.495 20.5 12 20.5 12 20.5s7.505 0 9.389-.566a2.997 2.997 0 0 0 2.11-2.12C24 15.921 24 12 24 12s0-3.921-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" /></svg>
                </a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <a href="https://github.com/tiago-vibes-on/hands-on" rel="noreferrer">Source code</a>
        </footer>
    </body>
</html>
