---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Tiago VibesOn",
    description = "HandsOn, helping the Hero Association."
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f7f7f2" />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href="/">Tiago VibesOn</a>
            <nav aria-label="Primary navigation">
                <a href="/projects">Projects</a>
                <a href="https://www.youtube.com/@TiagoVibesOn" rel="noreferrer">YouTube</a>
                <a href="https://github.com/tiago-vibes-on" rel="noreferrer">GitHub</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <span>HandsOn, helping the Hero Association.</span>
            <a href="https://github.com/tiago-vibes-on/hands-on" rel="noreferrer">Source code</a>
        </footer>
    </body>
</html>
