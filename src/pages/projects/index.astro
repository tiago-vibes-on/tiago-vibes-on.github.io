---
import { getCollection } from "astro:content";
import ProjectList from "../../components/ProjectList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
    .sort((first, second) => first.data.order - second.data.order);
---

<BaseLayout title="Projects | Tiago Vibes On">
    <section class="content-section page-intro">
        <p class="eyebrow">Projects</p>
        <h1>Build the system one decision at a time.</h1>
        <p class="lede">Every project has an initial and final checkpoint, source code, and a concise technical objective.</p>
        <ProjectList {projects} />
    </section>
</BaseLayout>
